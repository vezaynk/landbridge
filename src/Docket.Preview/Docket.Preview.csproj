<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The HTTP preview frontend (spec §8.4) is a standalone, separately-deployable
       module ON TOP of the pure TCP tunnel (§3) — its own ASP.NET host, NOT part
       of Docket.Mcp and NOT a change to the pure byte-splicer Docket.Relay. It
       reuses the shared Aspire service defaults (health, OTel) like the other
       hosts do. -->
  <ItemGroup>
    <ProjectReference Include="..\Docket.ServiceDefaults\Docket.ServiceDefaults.csproj" />
    <!-- §8.4: the frontend IS the consumer end. It dials the relay's existing
         /tunnel presenting the same RelayTunnel header names + consumer role
         string, so it shares that vocabulary via Docket.Contracts — the same way
         the runner's tunnel client does. It does NOT reference Docket.Relay (the
         splicer is untouched) or Docket.ControlPlane (it talks to the plane over
         the /preview/connect HTTP contract, like the relay talks to /relay/validate). -->
    <ProjectReference Include="..\Docket.Contracts\Docket.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
