{
  // docketd's config for the Aspire dev loop (§10 runner config). The AppHost
  // reads this template at startup and resolves two placeholders before writing
  // it out and passing --config to docketd:
  //   {work_root}      -> a temp scratch root the AppHost creates for this run
  //   {worker_harness} -> the absolute path to the built Docket.WorkerHarness
  // This is the seam an operator edits to run a REAL agent instead of the no-LLM
  // harness: swap the profile's "spawn" to e.g. ["grok", "agent", "stdio"] —
  // docketd needs no code change, only this data (§10). The worker learns its
  // assignment from get_task after the ACP handshake injects the plane MCP
  // server on session/new.
  // A real claude profile can also opt into §10 harness telemetry, which needs no
  // extra infrastructure here: the Aspire dashboard IS an OTLP collector, and docketd
  // (an Aspire resource) already has its endpoint in its environment, which the worker
  // inherits. So the endpoint can be omitted and only the harness's own knobs matter:
  //   "telemetry": {
  //     "otel": true,
  //     "env": {
  //       "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
  //       "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
  //       "OTEL_METRIC_EXPORT_INTERVAL": "5000"
  //     }
  //   }
  // Token/cost metrics then land in the dashboard beside the plane's own traces,
  // carrying docket.task_id. `grpc` because the dashboard's OTLP endpoint is gRPC;
  // the short interval because the 60s default can outlive a small task. See
  // docs/TELEMETRY.md — these are the harness's own numbers, not the plane's.
  //
  // docketd injects that turn and waits min(ttl, wind_down_seconds) for a voluntary
  // exit before a hard tree-kill. The scripted worker below reads stdin only as a
  // dead-man pipe and ignores turns, so it stays signal-mode (no "stop" block): a
  // cancel injects nothing but still grants it the full ttl to exit on its own
  // before the kill (only ttl=0 is immediate) — the honest behaviour for a harness
  // with no turn seam.
  "machine": {
    "work_root": "{work_root}",
    // Short cadence so a freshly-connected machine reports ready in ~2s and the
    // dispatch loop can hand it work promptly (the §10 default is 15s).
    "heartbeat_seconds": 2
  },
  "profiles": [
    {
      "name": "default",
      "spawn": ["{worker_harness}"]
    }
  ]
}
