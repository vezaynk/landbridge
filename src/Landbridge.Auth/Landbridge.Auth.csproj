<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The OAuth 2.1 authorization server (spec §5). Its own ASP.NET host, NOT
       part of Landbridge.Mcp: it is the only surface that renders HTML to a
       human, reads a passphrase form, and fetches remote CIMD documents, and
       none of that belongs in the process that owns Apply and /runner. It mints
       credentials; it does not read or write session state. -->
  <ItemGroup>
    <ProjectReference Include="..\Landbridge.ServiceDefaults\Landbridge.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Landbridge.ControlPlane\Landbridge.ControlPlane.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
