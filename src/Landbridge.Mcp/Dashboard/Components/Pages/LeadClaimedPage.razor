<DashboardDocument Title="Lead claimed" ActiveKey="connect">
<h1>Lead claimed</h1>
<p class="sub">Team <span class="mono">@TeamId</span>. Shown once. Give this token to the harness as <span class="mono">Authorization: Bearer</span>.</p>
<section class="secret">
    <label for="token">Lead token</label>
    <input id="token" type="text" class="mono" readonly value="@Token" />
    <p class="nt">Point the harness at <span class="mono">@McpUrl</span>.
        Read <span class="mono">landbridge://skills/lead</span>, then
        <span class="mono">list_profiles</span> before
        <span class="mono">create_session</span>.</p>
</section>
<p><a href="/dashboard/teams/@TeamId">Open this Team</a>
    · <a href="/dashboard/connect">← back to Connect</a></p>
</DashboardDocument>

@code {
    [Parameter, EditorRequired] public string Token { get; set; } = "";
    [Parameter] public Guid TeamId { get; set; }
    [Parameter, EditorRequired] public string McpUrl { get; set; } = "";
}
