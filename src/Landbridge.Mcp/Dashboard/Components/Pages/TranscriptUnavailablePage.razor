<DashboardDocument Title="Transcript unavailable">
<h1>Transcript unavailable</h1>
<p class="empty">@Unavailable.Detail</p>
@if (Unavailable.Reason == TranscriptUnavailable.NotTerminal)
{
    <p class="sub">Transcripts are served verbatim and are not redacted, so Landbridge
        serves them only for tasks that can never run again — a task still in flight may
        have a live worker credential in its transcript.</p>
}
</DashboardDocument>

@code {
    [Parameter, EditorRequired] public TranscriptResult.Unavailable Unavailable { get; set; } = default!;
}
