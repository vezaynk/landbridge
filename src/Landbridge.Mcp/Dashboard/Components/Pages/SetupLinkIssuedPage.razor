<DashboardDocument Title="Setup link" ActiveKey="connect">
<h1>One-time setup link</h1>
<p class="sub">First Team <span class="mono">@TeamId</span>. The URL is a capability, not the bearer.
    The first GET returns markdown that contains the factory token and then 404s.
    Pass that Team id as <span class="mono">teamId</span>, or call
    <span class="mono">create_team</span> for another.</p>
<section class="secret">
    <label for="prompt">Prompt</label>
    <textarea id="prompt" class="mono" readonly spellcheck="false" rows="4">@Prompt</textarea>
    <p class="nt">Expires @ExpiresAt.ToString("u"). Paste this into the harness
        that will lead the Team. Do not open the link yourself — a preview or
        reload burns it.</p>
</section>
<p><a href="@TeamHref(TeamId, TeamSlug)">Open this Team</a>
    · <a href="/dashboard/connect">← back to Connect</a></p>
</DashboardDocument>

@code {
    [Parameter, EditorRequired] public string Prompt { get; set; } = "";
    [Parameter] public DateTimeOffset ExpiresAt { get; set; }
    [Parameter] public Guid TeamId { get; set; }
    [Parameter] public string? TeamSlug { get; set; }
}
