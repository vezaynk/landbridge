@page "/dashboard/sessions/{SessionIdText}/transcripts"
@inherits DashboardPageBase
@inject TranscriptRelayService Relay

<PageTitle>Transcripts · @Label(SessionId, SessionSlug) · Landbridge</PageTitle>

@if (RefuseReason is { } reason)
{
    <div class="login-wrap card">
        <h1>Transcripts are a human surface</h1>
        <p class="empty">@reason</p>
        <p class="sub">This page is a human operator session. A Lead reads one bounded range with
            <code>read_transcript</code>. The bytes are verbatim and may contain secrets.</p>
    </div>
}
else if (Ready)
{
    <h1>Transcripts · session <code>@Label(SessionId, SessionSlug)</code></h1>
    <p class="sub mono">@SessionId</p>
    <section class="metrics">
        <div class="metric">
            <div class="l">Raw harness output, served verbatim. It may contain credentials, customer data, or anything
                else the agent read or printed. Landbridge does not redact transcripts (§13). Treat this text
                as sensitive.</div>
        </div>
    </section>

    <section>
        <h2>Dispatches</h2>
        @if (Locations.Count == 0)
        {
            <EmptyState Message="This task was never dispatched, so nothing was ever captured." />
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Dispatched</th><th>Machine</th><th>Readable now</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in Locations)
                    {
                        <tr>
                            <td>@Age(l.DispatchedAt, Now)</td>
                            <td>
                                @if (l.Machine is null)
                                {
                                    <span class="nt" title="not tracked yet">machine: n/a</span>
                                }
                                else
                                {
                                    <code title="@TitleFor(l.Machine!.Value)">@LabelFor(l.Machine)</code>
                                }
                            </td>
                            <td>
                                @if (l.Machine is null)
                                {
                                    <text>not recorded for this attempt</text>
                                }
                                else if (l.Connected)
                                {
                                    <Badge Text="machine connected" CssClass="state-working" />
                                }
                                else
                                {
                                    <Badge Text="machine offline" CssClass="state-parked" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section>
        <h2>Captured streams</h2>
        @if (Inventories.Count == 0)
        {
            <EmptyState Message="No machine that ran this task is connected. Transcripts live only on the machine that captured them, so there is nothing to read until one reconnects." />
        }
        @foreach (var inv in Inventories)
        {
            <h3>Machine <code title="@TitleFor(inv.Machine)">@LabelFor(inv.Machine)</code></h3>
            @if (inv.Unavailable is { } why)
            {
                <EmptyState Message="@why" />
            }
            else if (inv.Instances.Count == 0)
            {
                <EmptyState Message="This machine ran the task but captured nothing — transcript capture is off for its profile, or the worker wrote no output." />
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th class="num">Instance</th><th>Last write</th><th>stdout</th><th>stderr</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in inv.Instances)
                        {
                            <tr>
                                <td class="num">@i.Ordinal.ToString("D4")</td>
                                <td>@Age(i.LastWrite, Now)</td>
                                <td>@StreamLink(inv.Machine, i.Ordinal, "stdout", i.StdoutBytes)</td>
                                <td>@StreamLink(inv.Machine, i.Ordinal, "stderr", i.StderrBytes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </section>
}

@code {
    [Parameter] public string SessionIdText { get; set; } = "";
    private Guid SessionId { get; set; }
    private string? SessionSlug { get; set; }
    private IReadOnlyList<TranscriptLocationView> Locations { get; set; } = [];
    private IReadOnlyList<TranscriptMachineInventory> Inventories { get; set; } = [];
    private IReadOnlyDictionary<Guid, (string Name, string Slug)> MachineLabels { get; set; } =
        new Dictionary<Guid, (string Name, string Slug)>();
    protected override bool AutoRefresh => false;

    protected override async Task<string?> LoadAsync()
    {
        if (Principal is not Principal.Human)
            return "This session is a Lead credential. The dashboard transcript is a human operator session. Read one range with read_transcript.";
        var resolved = await Queries.ResolveSessionAsync(SessionIdText, RequestAborted);
        if (resolved.Malformed)
        {
            StatusOnRefuse = StatusCodes.Status400BadRequest;
            return "invalid session id";
        }
        if (resolved.Id is not { } id)
        {
            StatusOnRefuse = StatusCodes.Status404NotFound;
            return "no such session";
        }
        SessionId = id;
        SessionSlug = HaikuSlug.IsWellFormed(SessionIdText) ? SessionIdText : null;
        var ct = RequestAborted;
        Locations = await Queries.GetTranscriptLocationsAsync(SessionId, ct);
        MachineLabels = await Queries.MachineLabelsAsync(
            Locations.Where(l => l.Machine is not null).Select(l => l.Machine!.Value), ct);
        var task = new SessionId(SessionId);
        var core = Http.HttpContext?.RequestServices.GetService<CoreWriteClient>();
        var inventories = new List<TranscriptMachineInventory>();
        foreach (var machine in Locations
                     .Where(l => l is { Connected: true, Machine: not null })
                     .Select(l => l.Machine!.Value)
                     .Distinct())
        {
            inventories.Add(await TranscriptAccess.ReadAsync(
                Relay, core, OperatorToken, task, machine, ordinal: 0,
                TranscriptStreams.Stdout, offset: 0, TranscriptStreams.DefaultMaxBytes, ct) switch
            {
                TranscriptResult.Inventory inv => new TranscriptMachineInventory(machine, inv.Instances, null),
                TranscriptResult.Unavailable u => new TranscriptMachineInventory(machine, [], u.Detail),
                _ => new TranscriptMachineInventory(machine, [], "Unexpected reply."),
            });
        }
        Inventories = inventories;
        return null;
    }

    private string LabelFor(Guid? id)
    {
        if (id is not { } machine)
            return "—";
        MachineLabels.TryGetValue(machine, out var row);
        return MachineNameLabel(row.Name, row.Slug, machine.ToString("D"));
    }

    private string TitleFor(Guid id)
    {
        MachineLabels.TryGetValue(id, out var row);
        return MachineNameTitle(row.Slug, id.ToString("D"));
    }

    private RenderFragment StreamLink(Guid machine, int ordinal, string stream, long bytes)
    {
        var href = $"/dashboard/sessions/{Address(SessionId, SessionSlug)}/transcript?machine={machine:D}&ordinal={ordinal}&stream={stream}&follow=1";
        if (bytes == 0)
            return @<a href="@href">follow</a>;
        return @<a href="@href">@StreamBytes(bytes)</a>;
    }
}
