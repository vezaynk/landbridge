@page "/dashboard/events"
@inherits DashboardPageBase

<PageTitle>Event log · Landbridge</PageTitle>

@if (RefuseReason is { } reason)
{
    <ScopeCard Reason="@reason" />
}
else if (Ready)
{
    <h1>Event log</h1>
    @if (FilterSessionId is { } sid)
    {
        <p class="sub">Session <span class="mono">@(FilterSessionSlug ?? sid.ToString())</span>.
            <a href="/dashboard/events">All events</a>.</p>
    }
    else
    {
        <p class="sub">Transitions and Lead events in the last @WindowLabel, newest first.
            Takeovers, reboots, and evictions land here (§12).</p>
    }

    @if (List.Count == 0)
    {
        <EmptyState Message="@(FilterSessionId is null
            ? $"No events in the last {WindowLabel}."
            : $"No events for this session in the last {WindowLabel}.")" />
    }
    else
    {
        <section>
            <table>
                <thead>
                    <tr>
                        <th>When</th><th>Source</th><th>Kind</th><th>Transition</th>
                        <th>Team</th><th>Session / who</th><th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in List)
                    {
                        <tr>
                            <td>@Age(e.OccurredAt, Now)</td>
                            <td>
                                <Badge Text="@e.Source" CssClass="@(e.Source == "lead" ? "state-verifying" : "state-submitted")" />
                            </td>
                            <td>@e.Kind</td>
                            <td>
                                @if (e.FromState is { } f && e.ToState is { } to)
                                {
                                    <StateBadge State="@f" /> <text>→</text> <StateBadge State="@to" />
                                }
                                else if (e.ToState is { } only)
                                {
                                    <text>→ </text><StateBadge State="@only" />
                                }
                                else
                                {
                                    <span class="nt">—</span>
                                }
                            </td>
                            <td><TeamLink TeamId="@e.TeamId" Slug="@e.TeamSlug" /></td>
                            <td>
                                @if (e.Source == "lead")
                                {
                                    var who = e.HumanId is { } h ? ShortId(h) : "—";
                                    var prior = e.PriorHumanId is { } p ? $" (was {ShortId(p)})" : "";
                                    <span class="mono">@who</span><span class="nt">@prior</span>
                                }
                                else if (e.Namespace is { } ns)
                                {
                                    @if (e.SessionId is { } eventSession)
                                    {
                                        <a href="@SessionEventsHref(eventSession, e.SessionSlug)" title="@ns"><code>@Label(eventSession, e.SessionSlug)</code></a>
                                    }
                                    else
                                    {
                                        <code>@ns</code>
                                    }
                                }
                                else
                                {
                                    <span class="nt">—</span>
                                }
                            </td>
                            <td><EventDetail Event="@e" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "session")]
    public string? SessionQuery { get; set; }

    private Guid? FilterSessionId { get; set; }
    private string? FilterSessionSlug { get; set; }
    private IReadOnlyList<DashboardEvent> List { get; set; } = [];

    protected override async Task<string?> LoadAsync()
    {
        FilterSessionId = null;
        FilterSessionSlug = null;
        if (!string.IsNullOrEmpty(SessionQuery))
        {
            var resolved = await Queries.ResolveSessionAsync(SessionQuery, RequestAborted);
            if (resolved.Malformed)
            {
                // Garbage query: same as no filter, matching the Guid-only parser.
            }
            else if (resolved.Id is { } sid)
            {
                FilterSessionId = sid;
                FilterSessionSlug = HaikuSlug.IsWellFormed(SessionQuery) ? SessionQuery : null;
            }
            else
            {
                FilterSessionId = Guid.Empty;
            }
        }
        List = await Queries.GetEventsAsync(200, TeamScope, FilterSessionId, RequestAborted,
            since: Now - WindowDuration);
        if (FilterSessionId is { } id && FilterSessionSlug is null)
            FilterSessionSlug = List.FirstOrDefault(e => e.SessionId == id)?.SessionSlug;
        return null;
    }
}
