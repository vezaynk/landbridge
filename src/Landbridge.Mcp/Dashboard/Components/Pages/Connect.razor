@page "/dashboard/connect"
@inherits DashboardPageBase

<PageTitle>Connect · Landbridge</PageTitle>

@if (RefuseReason is { } reason)
{
    <ScopeCard Reason="@reason" />
}
else if (Ready && Principal is Principal.Lead)
{
    <h1>Connect</h1>
    <p class="sub">This session is a Lead factory. Paste that token into a harness, or open a Team it owns.</p>

    <section class="howto">
        <h2>Teams this factory owns</h2>
        @if (TeamScope is { Count: > 0 })
        {
            <p>
                @foreach (var id in TeamScope)
                {
                    <TeamLink TeamId="@id" Slug="@(TeamSlugs.GetValueOrDefault(id))" />
                }
            </p>
        }
        else
        {
            <p class="nt">None yet. Call <span class="mono">create_team</span>.</p>
        }
        <p>Every Lead tool except <span class="mono">create_team</span> and
            <span class="mono">list_profiles</span> takes a <span class="mono">teamId</span>.
            Do not write the id into the project. A new agent should call
            <span class="mono">create_team</span> rather than reuse an id from this page.</p>
        <p>The MCP endpoint is <span class="mono">POST @McpUrl</span> (the origin,
            not <span class="mono">/mcp</span>). For Grok, the token is the bearer on this session:</p>
        <pre class="howto">[mcp_servers.landbridge]
url = "@McpUrl"
enabled = true

[mcp_servers.landbridge.headers]
Authorization = "Bearer lbr_l_…"</pre>
        <p class="nt">Then refresh <span class="mono">/mcps</span> (or restart Grok).
            Read <span class="mono">landbridge://skills/lead</span>. Call
            <span class="mono">list_profiles</span>, then
            <span class="mono">create_session</span> with an exact name that came
            back and that <span class="mono">teamId</span>. There is no reserved
            <span class="mono">default</span>.</p>
        <p class="nt">Issuing another Lead token, a setup link, or an enrollment token
            is a human-operator action. This factory cannot mint one.</p>
    </section>
}
else if (Ready)
{
    <h1>Connect</h1>
    <p class="sub">Issue a Lead token for a harness, or an enrollment token for a new machine.</p>

    <section class="howto">
        <h2>Lead token</h2>
        <p>A Lead is a harness the operator drives. It talks to this plane over MCP
            with an <span class="mono">lbr_l_…</span> token. This dashboard login is a
            human session. The Lead token is a factory, not a Team — every Lead tool
            except <span class="mono">create_team</span> and
            <span class="mono">list_profiles</span> takes a <span class="mono">teamId</span>.</p>
        <form class="card connect-claim" method="post" action="/dashboard/connect/claim">
            <label for="teamId">Team id</label>
            <input id="teamId" type="text" name="teamId" class="mono"
                   spellcheck="false" autocomplete="off"
                   placeholder="leave blank to start a new Team" />
            <label class="check">
                <input type="checkbox" name="takeover" value="true" />
                <span>Take over if this Team already has a Lead. The Team moves to the new token. A factory that owned only this Team is revoked, and its next call names who took it. A factory that still owns another Team stays live and loses only this one.</span>
            </label>
            <button type="submit">Issue Lead token</button>
            <button type="submit" formaction="/dashboard/connect/setup-link">
                One-time setup link
            </button>
            <p class="nt">Issue Lead token shows the token once. One-time setup link
                mints a URL whose first GET is markdown that contains the bearer.
                Paste that URL to an agent; do not open it yourself.</p>
        </form>
        <p class="nt">OAuth here (authorization code + PKCE, the same operator passphrase)
            mints an <span class="mono">lbr_h_…</span> human session, not a Lead.
            Issue a Lead token with the form. Discovery is
            <span class="mono">/.well-known/oauth-protected-resource</span> and
            <span class="mono">/.well-known/oauth-authorization-server</span>.
            This plane has no <span class="mono">/register</span>; clients are
            identified by a Client ID Metadata Document.</p>
        <p>Point the harness at <span class="mono">POST @McpUrl</span> (the origin,
            not <span class="mono">/mcp</span>). For Grok:</p>
        <pre class="howto">[mcp_servers.landbridge]
url = "@McpUrl"
enabled = true

[mcp_servers.landbridge.headers]
Authorization = "Bearer lbr_l_…"</pre>
        <p class="nt">Then refresh <span class="mono">/mcps</span> (or restart Grok).
            Read <span class="mono">landbridge://skills/lead</span>. Call
            <span class="mono">list_profiles</span>, then
            <span class="mono">create_session</span> with an exact name that came
            back and that <span class="mono">teamId</span>. There is no reserved
            <span class="mono">default</span>. Do not write the team id into the project.</p>
    </section>

    <section class="howto">
        <h2>Enroll a machine</h2>
        <p><span class="mono">landbridged</span> dials out. Enrollment exchanges a
            single-use, 15-minute token for persistent machine credentials. Never put
            the token on argv — it would land in shell history and
            <span class="mono">/proc/…/cmdline</span>.</p>
        <form class="card connect-enroll" method="post" action="/dashboard/connect/enroll-token">
            <button type="submit">Issue enrollment token</button>
            <p class="nt">Shown once. 15 minutes, single-use.</p>
        </form>
        <p>On the box, write it to a <span class="mono">0600</span> file and exchange it.
            <span class="mono">--auth-url</span> is the authorization server, where
            <span class="mono">/enroll</span> lives. <span class="mono">--name</span> is
            the Machine Group label (defaults to hostname), not a runner profile.</p>
        <pre class="howto">landbridged --enroll \
  --auth-url @AuthUrl \
  --enroll-token-file ./enroll.token \
  --name $(hostname -s) \
  --state-dir /var/lib/landbridged

# or pipe, no file (same --state-dir, or omit both to use ~/.landbridge):
landbridged --enroll --auth-url @AuthUrl --state-dir /var/lib/landbridged &lt; enroll.token</pre>
        <p class="nt">That writes <span class="mono">credentials.json</span> under the
            state dir (<span class="mono">0600</span> in a <span class="mono">0700</span>
            directory). The exchange answers with the plane's control URL, so the
            daemon does not need it on the command line. Use the same
            <span class="mono">--state-dir</span> when you start
            <span class="mono">landbridged</span> (omit both to use
            <span class="mono">~/.landbridge</span>). Treat that file as the machine:
            a copy is a working identity on any host. The runner config and the
            profile check are in <span class="mono">landbridge://skills/enroll</span>
            and <span class="mono">landbridge://skills/runner-config</span>.</p>
    </section>
}

@code {
    [Inject] private IConfiguration Config { get; set; } = default!;

    protected override bool AutoRefresh => false;

    private string McpUrl { get; set; } = DispatchService.DefaultPublicMcpUrl;
    private string AuthUrl { get; set; } = DispatchService.DefaultPublicMcpUrl;

    protected override Task<string?> LoadAsync()
    {
        McpUrl = ConnectEndpoints.ResolveMcpUrl(Config, Http.HttpContext);
        AuthUrl = ConnectEndpoints.ResolveAuthUrl(Config, Http.HttpContext);
        return Task.FromResult<string?>(null);
    }
}
