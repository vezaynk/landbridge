<DashboardDocument Title="Enrollment prompt" ActiveKey="connect">
<h1>Enrollment prompt</h1>
<p class="sub">Paste this into a harness on the machine you are enrolling.
    Shown once. The token inside expires @ExpiresAt.ToString("u"). 15 minutes, single-use.</p>
<section class="secret">
    <label for="prompt">Prompt</label>
    <textarea id="prompt" class="mono" readonly spellcheck="false" rows="22">@Prompt</textarea>
    <p class="nt">Select the prompt and paste it into a harness on that box.
        It carries the enrollment token and the enrollment skill. Never put the
        token on argv.</p>
</section>
<p><a href="/dashboard/connect">← back to Connect</a></p>
</DashboardDocument>

@code {
    [Parameter, EditorRequired] public string Prompt { get; set; } = "";
    [Parameter] public DateTimeOffset ExpiresAt { get; set; }
}
