@page "/dashboard"
@page "/dashboard/machines"
@layout DashboardLayout
@inherits DashboardPageBase
@inject DashboardTeamState TeamState

<PageTitle>Observability center · Landbridge</PageTitle>

@if (RefuseReason is { } reason)
{
    <div class="login-wrap card">
        <h1>Fleet board</h1>
        <ScopeCard Reason="@reason" />
        <p><a href="/dashboard/teams">← your Team</a></p>
    </div>
}
else if (Ready && Snapshot is { } snap)
{
    <div class="obs-page">
        <ObservabilityDashboard Snapshot="snap" Now="Now" WindowLabel="@WindowLabel"
            Teams="Teams" SelectedTeamId="SelectedTeamId" Binding="Binding"
            HumanId="HumanId" OnChanged="ReloadAsync" />
    </div>
}

@code {
    private ObservabilitySnapshot? Snapshot { get; set; }
    private IReadOnlyList<TeamOverview> Teams { get; set; } = [];
    private Guid? SelectedTeamId { get; set; }
    private LeadMachineBinding? Binding { get; set; }

    private Guid HumanId => Principal is Principal.Human h ? h.HumanId : Guid.Empty;

    protected override async Task<string?> LoadAsync()
    {
        if (Principal is not Principal.Human)
        {
            return "the machine group is a human-operator view; a Lead session sees its owned Teams "
                + "on /dashboard/teams and through get_team_state";
        }
        Teams = await Queries.GetTeamsAsync(teamScope: null, RequestAborted);
        SelectedTeamId = await ResolveTeamAsync(Teams);
        Binding = Principal is Principal.Human h
            ? await Queries.GetHumanBindingAsync(h.HumanId, RequestAborted)
            : null;
        Snapshot = await Queries.GetObservabilityAsync(
            Now, WindowDuration, teamScope: null, RequestAborted, teamId: SelectedTeamId);
        return null;
    }

    private async Task<Guid?> ResolveTeamAsync(IReadOnlyList<TeamOverview> teams)
    {
        if (teams.Count == 0)
            return null;
        var http = Http.HttpContext;
        var key = DashboardTeam.QueryValue(Nav.Uri);
        if (!string.IsNullOrEmpty(key))
        {
            TeamState.Set(key);
            await PersistPrefCookieAsync(DashboardTeam.CookieName, key, http);
        }
        else if (TeamState.Chosen)
            key = TeamState.Key;
        else if (http is not null)
        {
            key = DashboardTeam.ResolveKey(http);
            if (!string.IsNullOrEmpty(key))
                TeamState.Set(key);
        }
        if (!string.IsNullOrEmpty(key))
        {
            var match = teams.FirstOrDefault(t =>
                t.Slug.Equals(key, StringComparison.OrdinalIgnoreCase)
                || t.TeamId.ToString().Equals(key, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
                return match.TeamId;
        }
        if (SelectedTeamId is { } current && teams.Any(t => t.TeamId == current))
            return current;
        return teams[0].TeamId;
    }
}
