@using Landbridge.ControlPlane
@inject NavigationManager Nav
@inject FleetBoardMutations Mutations
<div class="obs-rail">
    <div class="obs-rail__title">Teams</div>
    <div class="obs-rail__list obs-rail__list--teams">
        @if (Teams.Count == 0)
        {
            <div class="obs-team">
                <span class="obs-team__id" style="color:var(--color-neutral-700)">No teams.</span>
            </div>
        }
        @foreach (var t in Teams)
        {
            <a class="obs-team @(t.TeamId == SelectedTeamId ? "is-on" : "")" href="@DashboardTeam.Href(Nav.Uri, DashboardTeam.Address(t.TeamId, t.Slug))" title="@t.TeamId">
                <span class="obs-team__id">@Label(t.TeamId, t.Slug)</span>
                <span class="obs-team__spacer"></span>
                <span class="obs-team__n">@t.TotalSessions</span>
            </a>
        }
    </div>
    <div class="obs-rail__title">Machines</div>
    <div class="obs-rail__list obs-rail__list--machines">
        @if (Machines.Count == 0)
        {
            <div class="obs-machine">
                <span class="obs-machine__id" style="color:var(--color-neutral-700)">No machines connected.</span>
            </div>
        }
        @foreach (var m in Machines)
        {
            <div class="obs-machine">
                <span class="obs-machine__dot" style="background:@(m.UnderBackPressure ? "var(--state-wait)" : m.Ready ? "var(--state-live)" : "var(--color-neutral-700)")"></span>
                <span class="obs-machine__id" title="@(string.IsNullOrEmpty(m.Name) ? m.MachineId : $"{m.Name} · {m.MachineId}")">@Label(m.MachineId, m.Slug)</span>
                <span class="obs-machine__spacer"></span>
                <span class="obs-machine__load">@LoadText(m)</span>
                @if (IsBoundMachine(m))
                {
                    <button type="button" class="obs-machine__act" disabled="@Busy" title="Unbind this box"
                            @onclick="UnbindAsync">unbind</button>
                }
                else
                {
                    <button type="button" class="obs-machine__act" disabled="@Busy" title="Bind this box as yours"
                            @onclick="() => BindAsync(m.MachineId)">bind</button>
                }
                <form class="obs-machine__revoke" method="post" action="/dashboard/machines/revoke">
                    <input type="hidden" name="machineId" value="@m.MachineId" />
                    <button type="submit" title="Revoke machine">revoke</button>
                </form>
            </div>
        }
    </div>
    <div class="obs-rail__fill"></div>
    <div class="obs-rail__footnote">
        @HeartbeatLine<br />
        @BackPressureCount machine@(BackPressureCount == 1 ? "" : "s") under back-pressure<br />
        no subagents reported
        @if (IdleMachineEmpty)
        {
            <text><br />No sessions running on this machine.</text>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ObservabilityMachine> Machines { get; set; } = [];

    [Parameter]
    public DateTimeOffset Now { get; set; }

    [Parameter]
    public int LaneCount { get; set; }

    [Parameter]
    public IReadOnlyList<TeamOverview> Teams { get; set; } = [];

    [Parameter]
    public Guid? SelectedTeamId { get; set; }

    [Parameter]
    public LeadMachineBinding? Binding { get; set; }

    [Parameter]
    public Guid HumanId { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<FleetNotice> OnNotice { get; set; }

    private bool Busy { get; set; }

    private bool IsBoundMachine(ObservabilityMachine m) =>
        Binding is { } b
        && Guid.TryParse(m.MachineId, out var id)
        && id == b.MachineId;

    private int BackPressureCount => Machines.Count(m => m.UnderBackPressure);

    private bool IdleMachineEmpty =>
        LaneCount == 0 && Machines.Count > 0 && Machines.All(m => m.RunningSessionCount == 0);

    private string HeartbeatLine
    {
        get
        {
            if (Machines.Count == 0 || Machines.Any(m => m.LastHeartbeat is null))
                return "heartbeat —";
            var oldest = Machines.Max(m => Now - m.LastHeartbeat!.Value);
            if (oldest < TimeSpan.FromSeconds(5))
                return "heartbeat < 5s on all";
            var secs = (int)oldest.TotalSeconds;
            return secs < 60 ? $"oldest heartbeat {secs}s" : $"oldest heartbeat {secs / 60}m";
        }
    }

    private static string LoadText(ObservabilityMachine m)
    {
        if (m.UnderBackPressure)
            return "back-pressure";
        if (m.Ready)
            return m.RunningSessionCount > 0 ? $"ready · {m.RunningSessionCount}" : "ready";
        return "not ready";
    }

    private Task BindAsync(string machineId) =>
        Guid.TryParse(machineId, out var id)
            ? Run(() => Mutations.BindMachineAsync(HumanId, id, CancellationToken.None))
            : Task.CompletedTask;

    private Task UnbindAsync() => Run(() => Mutations.UnbindMachineAsync(HumanId, CancellationToken.None));

    private async Task Run(Func<Task<FleetNotice>> action)
    {
        if (Busy)
            return;
        Busy = true;
        try
        {
            var notice = await action();
            await OnNotice.InvokeAsync(notice);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            await OnNotice.InvokeAsync(new FleetNotice("Failed", ex.Message, Error: true));
        }
        finally
        {
            Busy = false;
        }
    }
}
