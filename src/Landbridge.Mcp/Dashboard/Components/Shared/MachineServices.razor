@if (Machine.Services is { Count: > 0 })
{
    <div class="machine-services">
        <h3>Services <span class="nt">declared by the operator on this machine</span></h3>
        <table>
            <thead>
                <tr>
                    <th>Service</th><th>State</th><th>Port</th><th>Up for</th>
                    <th>Restarts</th><th>Last exit</th><th>Last failure</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Machine.Services)
                {
                    <tr>
                        <td><code>@s.Name</code></td>
                        <td>@ServiceBadge(s.State)</td>
                        <td>
                            @if (s.Port == 0)
                            {
                                <span class="nt">n/a</span>
                            }
                            else
                            {
                                @s.Port
                            }
                        </td>
                        <td>
                            @if (s.StartedAt is null)
                            {
                                <span class="nt">—</span>
                            }
                            else
                            {
                                @Age(s.StartedAt, Now)
                            }
                        </td>
                        <td>@s.Restarts</td>
                        <td>
                            @if (s.LastExitCode is { } exitCode)
                            {
                                @exitCode
                            }
                            else
                            {
                                <span class="nt">—</span>
                            }
                        </td>
                        <td>
                            @if (s.LastFailureAt is null)
                            {
                                <span class="nt">never</span>
                            }
                            else
                            {
                                @Age(s.LastFailureAt, Now)
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="nt">Log contents are captured on the machine, under the state
            directory, and are not served here (§16 open question 8).</p>
    </div>
}

@code {
    [Parameter, EditorRequired] public MachineView Machine { get; set; } = default!;
    [Parameter] public DateTimeOffset Now { get; set; }

    private static RenderFragment ServiceBadge(ServiceState state) => state switch
    {
        ServiceState.Running => @<Badge Text="running" CssClass="ready" />,
        ServiceState.Starting => @<Badge Text="starting" CssClass="state-submitted" />,
        ServiceState.Failed => @<Badge Text="failed" CssClass="down" />,
        ServiceState.Disabled => @<Badge Text="disabled" CssClass="nt" />,
        _ => @<Badge Text="stopped" CssClass="backpressure" />,
    };
}
