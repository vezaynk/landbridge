<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>2fa1335d-4ad1-4a17-9840-6ee1ba80110a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marked as Aspire project resources so the SDK generates the
         Projects.Landbridge_Mcp metadata the app host references. landbridged
         is a Linux container (docker/Landbridge.Landbridged.Dockerfile), not
         an Aspire project resource. -->
    <ProjectReference Include="..\Landbridge.Hub\Landbridge.Hub.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\Landbridge.Mcp\Landbridge.Mcp.csproj" IsAspireProjectResource="true" />
    <!-- landbridge-relay, brought into the dev loop as its own host (§8.3). -->
    <ProjectReference Include="..\Landbridge.Relay\Landbridge.Relay.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\Landbridge.Preview\Landbridge.Preview.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\Landbridge.Classifier\Landbridge.Classifier.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\Landbridge.ControlPlane\Landbridge.ControlPlane.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
