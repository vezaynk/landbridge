<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The end-to-end test hosts the real MCP server on a loopback Kestrel port and
       drives it with the MCP C# SDK client, so it needs the ASP.NET Core shared
       framework plus a Postgres-backed store. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0-rc.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Reuse the ControlPlane test suite's ephemeral-Postgres fixture verbatim
       (single source of truth) rather than duplicating it. -->
  <ItemGroup>
    <Compile Include="..\Landbridge.ControlPlane.Tests\PostgresFixture.cs" Link="PostgresFixture.cs" />
    <Compile Include="..\Landbridge.ControlPlane.Tests\TestMachines.cs" Link="TestMachines.cs" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Landbridge.Mcp\Landbridge.Mcp.csproj" />
    <!-- The end-to-end spine test dials the control plane with the real landbridged
         WebSocket channel, so it references the runner. -->
    <ProjectReference Include="..\..\src\Landbridge.Runner\Landbridge.Runner.csproj" />
    <!-- The relay grant-validator crown test stands up the real relay host next to
         the plane and splices two ClientWebSockets over a real issued grant (§8.3). -->
    <ProjectReference Include="..\..\src\Landbridge.Relay\Landbridge.Relay.csproj" />
    <!-- The §8.4 preview crown drives the real preview frontend through the real
         relay + a real producer landbridged, so it references the preview module. -->
    <ProjectReference Include="..\..\src\Landbridge.Preview\Landbridge.Preview.csproj" />
    <!-- Referenced so the fake worker harness binary is built and locatable; the
         walking-skeleton E2E spawns it as a real MCP-speaking child process
         (§10 conventions — a real spawnable child, no shell). -->
    <ProjectReference Include="..\Landbridge.WorkerHarness\Landbridge.WorkerHarness.csproj" />
    <!-- The §11 resume crown spawns the runner test harness for real (emit-stream to
         report a session id, echo-argv to prove the resume argv), so it references
         it to build and locate that binary. -->
    <ProjectReference Include="..\Landbridge.Runner.TestHarness\Landbridge.Runner.TestHarness.csproj" />
  </ItemGroup>

</Project>
