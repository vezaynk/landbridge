<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Local paid-e2e keys. Loaded at assembly start and published into the
         process environment so spawned CLIs inherit them. CI sets the same
         names as job env and is not overwritten. -->
    <UserSecretsId>a7e4c8b2-1f93-4d6a-9e20-6c8f1b0d4e7a</UserSecretsId>
  </PropertyGroup>

  <!-- Each scenario hosts a real MCP plane + a real relay on loopback Kestrel ports
       and drives them with the MCP C# SDK client, so it needs the ASP.NET Core shared
       framework plus a Postgres-backed store. Mirrors Docket.Mcp.Tests. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0-rc.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The shared rig kit is source-linked below; a global using keeps every scenario
         file from repeating the import for a type that is effectively part of this suite. -->
    <Using Include="Docket.RigSupport" />
  </ItemGroup>

  <!-- Reuse the ControlPlane suite's ephemeral-Postgres fixture verbatim (single
       source of truth) rather than duplicating it, exactly like Docket.Mcp.Tests. -->
  <ItemGroup>
    <Compile Include="..\Docket.ControlPlane.Tests\PostgresFixture.cs" Link="PostgresFixture.cs" />
    <!-- The plane-facing half a fleet rig needs regardless of how it stands its machines
         up: loopback reservation, the bounded poll, the Lead MCP surface, and the
         committed-facts dump. Shared with Docket.Chaos.Tests as source (the
         HarnessSupport idiom) because the two rigs cannot share an assembly — Chaos
         deliberately keeps Docket.Runner off its compile closure. -->
    <Compile Include="..\RigSupport\PlaneProbe.cs" Link="PlaneProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The plane (MCP tools + relay-validation endpoint), the relay host, and the
         runner data planes are all stood up for real; no fakes on any surface that
         matters (§8.3). -->
    <ProjectReference Include="..\..\src\Docket.Mcp\Docket.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Docket.Runner\Docket.Runner.csproj" />
    <ProjectReference Include="..\..\src\Docket.Relay\Docket.Relay.csproj" />
    <!-- Referenced so the scripted collaborator binary is built and locatable; each
         scenario spawns it as a real MCP-speaking child process (§10 conventions —
         a real spawnable child, no shell), one instance per enrolled machine. -->
    <ProjectReference Include="..\Docket.CollabHarness\Docket.CollabHarness.csproj" />
    <!-- Referenced for its `http-serve` mode: the §8.2/§8.3 real-claude scenario needs a
         long-lived listener a worker can start through `start_process` and a consumer on
         another machine can fetch through the relay. It must be a real binary at a real
         absolute path on every platform CI runs, which is exactly this harness's job — an
         interpreter that happens to be installed is not a guarantee. -->
    <ProjectReference Include="..\Docket.Runner.TestHarness\Docket.Runner.TestHarness.csproj" />
  </ItemGroup>

</Project>
